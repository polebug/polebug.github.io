---
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '../styles/global.css';
// Lato and Noto Serif SC's Latin letters (titles, summaries) are preloaded so they are usually ready
// for the first paint: no swap from the fallback, no re-wrapping titles.
import lato400 from '@fontsource/lato/files/lato-latin-400-normal.woff2?url';
import serifLatin400 from '@fontsource/noto-serif-sc/files/noto-serif-sc-latin-400-normal.woff2?url';
import serifLatin600 from '@fontsource/noto-serif-sc/files/noto-serif-sc-latin-600-normal.woff2?url';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  nav?: 'blog' | 'archive' | 'notes';
  wide?: boolean;
}
const { title, description = SITE.description, nav, wide } = Astro.props;
const pageTitle = title ? `${title} · Polebug` : `Polebug · Blog`;
// In `npm run dev` the homepage runs on port 8000 of the same machine.
const homeUrl = import.meta.env.DEV ? `http://${Astro.url.hostname}:8000/` : SITE.homeUrl;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title ?? 'Polebug · Blog'}>
  <meta property="og:description" content={description}>
  <link rel="preload" as="font" type="font/woff2" href={lato400} crossorigin>
  <link rel="preload" as="font" type="font/woff2" href={serifLatin400} crossorigin>
  <link rel="preload" as="font" type="font/woff2" href={serifLatin600} crossorigin>
  <link rel="icon" href="/avatar.png">
  <link rel="alternate" type="application/atom+xml" title={SITE.title} href="/atom.xml">
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  <script is:inline>
    // Apply the remembered colour scheme before the first paint: the polebug.com cookie (shared with
    // the homepage), else localStorage.
    {
      const m = document.cookie.match(/(?:^|; )theme=(light|dark)/);
      let theme = m && m[1];
      try { theme ||= localStorage.getItem('theme'); } catch {}
      if (theme === 'light') document.documentElement.dataset.theme = 'light';
    }
  </script>
  <slot name="head" />
</head>
<body>
  <header class="site-header">
    <a class="site-mark" href={homeUrl} aria-label="Polebug home"><img src="/avatar.png" alt="Polebug's avatar" width="52" height="52"></a>
    <nav aria-label="Main navigation">
      <a href={homeUrl}>About</a>
      <a href="/" aria-current={nav === 'blog' ? 'page' : undefined}>Blog</a>
      <a href="/archives/" aria-current={nav === 'archive' ? 'page' : undefined}>Archive</a>
      <a href={SITE.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
      <button type="button" class="theme-toggle" title="Dark / light" aria-label="Toggle dark / light">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </header>
  <script>
    // The header's theme toggle: flips the scheme on <html>, remembers it, and tells the comments
    // frame so it follows.
    document.querySelector('.theme-toggle')?.addEventListener('click', () => {
      const light = document.documentElement.dataset.theme !== 'light';
      document.documentElement.dataset.theme = light ? 'light' : 'dark';
      const domain = location.hostname.endsWith('polebug.com') ? '; domain=polebug.com' : '';
      document.cookie = `theme=${light ? 'light' : 'dark'}; path=/; max-age=31536000; samesite=lax${domain}`;
      try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch {}
      document.querySelector<HTMLIFrameElement>('iframe.utterances-frame')?.contentWindow
        ?.postMessage({ type: 'set-theme', theme: light ? 'github-light' : 'github-dark' }, 'https://utteranc.es');
    });
  </script>
  <main class:list={[{ wide }]}>
    <slot />
  </main>
  <footer class="site-footer">
    <span>© 2024–{year} Polebug · Text and photos under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener license">CC BY-NC-SA 4.0</a></span>
    <span><span data-stats hidden><span data-stat="site-visitors" data-unit="visitor"></span> · <span data-stat="site-views" data-unit="view"></span> · </span><a href="/atom.xml">RSS</a> · <a href="https://github.com/polebug/polebug.github.io" target="_blank" rel="noopener">Source</a></span>
  </footer>
  <script>
    // Count this view (stats/, the visitor counter) and fill in the figures: the site's in the
    // footer, the page's on a post's cover. Without an answer they stay hidden.
    const stats = location.hostname.endsWith('polebug.com') ? 'https://stats.polebug.com' : `http://${location.hostname}:8787`;
    fetch(`${stats}/hit`, { method: 'POST', body: JSON.stringify({ site: 'blog', path: location.pathname }) })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((n) => {
        const figures: Record<string, number> = { views: n.views, visitors: n.visitors, 'site-views': n.site.views, 'site-visitors': n.site.visitors };
        document.querySelectorAll<HTMLElement>('[data-stat]').forEach((el) => {
          const k = figures[el.dataset.stat!];
          el.textContent = `${k.toLocaleString('en')} ${el.dataset.unit}${k === 1 ? '' : 's'}`;
        });
        document.querySelectorAll<HTMLElement>('[data-stats]').forEach((el) => { el.hidden = false; });
      })
      .catch(() => {});
  </script>
</body>
</html>
