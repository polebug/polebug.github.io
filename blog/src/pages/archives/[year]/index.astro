---
import Archive from '../../../components/Archive.astro';
import { getPosts, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.map((p) => p.ymd.year))].map((year) => ({
    params: { year },
    props: { posts: posts.filter((p) => p.ymd.year === year) },
  }));
}
const { posts } = Astro.props as { posts: Post[] };
---
<Archive posts={posts} heading={Astro.params.year} />
