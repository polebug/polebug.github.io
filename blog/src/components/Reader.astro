---
import { stamp, type Post } from '../lib/posts';

// The reader, in the manner of WeRead's web reader: one panel the height of the window, with
// whatever is slotted in (the index's entries, or a post) flowing through it two columns at a
// time, paged with the buttons in the bottom corners (CSS columns laid out sideways; the script
// slides the flow one window at a time). A rail beside it holds the catalogue (a drawer listing
// every post) and the 翻页 / 滚动 switch, which turns the panel into a single scrolling column
// instead. Without JavaScript the whole flow shows at once.
//
// `start` is the index of the block (.entry, or a block of the post) to open at. The catalogue
// lists `posts` (the index) or `headings` (a post's own sections), and jumps within the flow. A
// "cover" slot (a post's title page) takes the first column, the text starting beside it, as a
// book's cover does in WeRead; a "rail" slot adds buttons to the rail. `back` (a post's own URL)
// puts a button beside the running head that returns to the index, opened at that post's entry.
interface Heading { depth: number; slug: string; text: string }
interface Props { posts?: Post[]; headings?: Heading[]; start?: number; label: string; back?: string }
const { posts, headings, start = 0, label, back } = Astro.props;
---
<div class="reading">
  <section class="reader" aria-label={label} data-start={start}>
    <header class="reader-head">
      <span class="running">
        {back && (
          <a class="back" href="/" data-post={back} title="Back to posts" aria-label="Back to posts">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          </a>
        )}
        Blog
      </span>
      <span class="motto-sm">保持思考 · 等待 · 斋戒</span>
    </header>

    <div class="pages">
      <div class="flow">
        {Astro.slots.has('cover') && <div class="cover"><slot name="cover" /></div>}
        <slot />
      </div>
    </div>

    <nav class="reader-foot" aria-label="Pages">
      <button type="button" class="prev">‹ Prev</button>
      <span class="where" aria-live="polite"></span>
      <button type="button" class="next">Next ›</button>
    </nav>
  </section>

  <nav class="rail" aria-label="Reading controls">
    <button type="button" class="toc-open" title="Contents" aria-label="Contents">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
    </button>
    <button type="button" class="mode" title="Switch to scrolling" aria-label="Switch to scrolling">
      <svg class="ico-scroll" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M12 3 8.5 6.5M12 3l3.5 3.5M12 21l-3.5-3.5M12 21l3.5-3.5"/></svg>
      <svg class="ico-page" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h7v14H4zM13 5h7v14h-7z"/></svg>
    </button>
    <slot name="rail" />
  </nav>
</div>
<script is:inline>
  // Before the first paint: mark the reader as scripted and apply the remembered mode, so the page
  // doesn't flash the no-JS layout (the whole flow at once) before the module below runs.
  (function () {
    var r = document.querySelector('.reader');
    if (!r) return;
    r.classList.add('ready');
    var mobile = matchMedia('(max-width: 860px)').matches;
    var mode = 'page';
    try { if (localStorage.getItem('reader-mode') === 'scroll') mode = 'scroll'; } catch (e) {}
    r.dataset.mode = mobile ? 'scroll' : mode;
    // Tie each "Continue reading" to the last block of its summary, so a column break can't part
    // them and the fade (see .tail in BlogIndex) sits just above the link. Here, not in the module
    // below, so the first paint already has the fade and the final columns.
    r.querySelectorAll('.entry').forEach(function (e) {
      var summary = e.querySelector('.summary'), last = summary && summary.lastElementChild, more = e.querySelector('.more');
      if (!last || !more) return;
      var tail = document.createElement('div');
      tail.className = 'tail';
      summary.append(tail);
      tail.append(last, more);
    });
  })();
</script>

<dialog class="drawer toc" aria-label="Contents">
  <header>
    <span class="running">Contents</span>
    <span class="drawer-count">{posts ? `${posts.length} posts` : `${headings?.length ?? 0} sections`}</span>
    <button type="button" class="drawer-close" aria-label="Close">×</button>
  </header>
  <ol>
    {posts?.map((post, i) => (
      <li><button type="button" data-i={i}><time>{stamp(post.data.date)}</time><span>{post.data.title}</span></button></li>
    ))}
    {headings?.map((h) => (
      <li class={`depth-${h.depth}`}><button type="button" data-id={h.slug}><span>{h.text}</span></button></li>
    ))}
    {!posts && !headings?.length && <li class="none">This post has no section headings.</li>}
  </ol>
</dialog>

<script>
  const reader = document.querySelector<HTMLElement>('.reader')!;
  const pages = reader.querySelector<HTMLElement>('.pages')!;
  const flow = reader.querySelector<HTMLElement>('.flow')!;
  const where = reader.querySelector<HTMLElement>('.reader-foot .where')!;
  const prev = reader.querySelector<HTMLButtonElement>('.reader-foot .prev')!;
  const next = reader.querySelector<HTMLButtonElement>('.reader-foot .next')!;
  const pendingImages = new Set(flow.querySelectorAll<HTMLImageElement>('img[loading="lazy"]'));
  const entries = [...flow.querySelectorAll<HTMLElement>('.entry')];
  // The blocks the reader keeps its place by: the index's entries, or a post's header and paragraphs.
  const marks = entries.length ? entries : [...flow.querySelectorAll<HTMLElement>('.cover, .prose > *, .post-nav')];
  const modeButton = document.querySelector<HTMLButtonElement>('.rail .mode')!;
  const toc = document.querySelector<HTMLDialogElement>('dialog.toc')!;
  let current = 0;
  let count = 1;
  let paginationReady = false;
  // Use real dimensions from the media manifest, not whether an image has downloaded yet.
  // Save author styles so scroll mode (including mobile) keeps its original sizing.
  const sizedMedia = [...flow.querySelectorAll<HTMLImageElement | HTMLVideoElement>('img, video[width][height]')]
    .map(element => ({ element, width: Number(element.getAttribute('width')), height: Number(element.getAttribute('height')), styleWidth: element.style.width, styleHeight: element.style.height }));
  const sizePageMedia = () => {
    const columnWidth = (flow.clientWidth - parseFloat(getComputedStyle(flow).columnGap)) / 2;
    for (const item of sizedMedia) {
      const { element } = item;
      if (!paged()) {
        element.style.width = item.styleWidth;
        element.style.height = item.styleHeight;
        continue;
      }
      const width = item.width || (element instanceof HTMLImageElement ? element.naturalWidth : 0);
      const height = item.height || (element instanceof HTMLImageElement ? element.naturalHeight : 0);
      if (!(width > 0 && height > 0)) continue;
      const ratio = width / height;
      let maxHeight = Math.min(flow.clientHeight, parseFloat(getComputedStyle(element).maxHeight) || Infinity);
      const figure = element.parentElement;
      if (figure?.classList.contains('media-figure')) {
        const caption = figure.querySelector('figcaption');
        const captionSpace = caption ? caption.getBoundingClientRect().height + parseFloat(getComputedStyle(caption).marginBottom) : 0;
        const spacing = captionSpace + parseFloat(getComputedStyle(figure).marginBottom) + 2;
        maxHeight = Math.min(maxHeight, flow.clientHeight - spacing);
        // Keep an image readable, but use a mostly empty current column rather than
        // moving a full-height photo and its short introduction to the next one.
        const previous = figure.previousElementSibling;
        const previousRects = previous ? [...previous.getClientRects()] : [];
        const last = previousRects.at(-1);
        if (last) {
          const available = flow.getBoundingClientRect().bottom - last.bottom
            - Math.max(0, parseFloat(getComputedStyle(previous!).marginBottom)) - spacing;
          const fullHeight = Math.min(height, columnWidth / ratio, maxHeight);
          if (available >= fullHeight * 0.45 && available >= flow.clientHeight * 0.35) {
            maxHeight = Math.min(maxHeight, available);
          }
        }
      }
      maxHeight = Math.max(1, maxHeight);
      element.style.width = `${Math.min(width, columnWidth, maxHeight * ratio)}px`;
      // Let the original max-width and the containing block constrain the width first.
      // Explicit pixel height then stays identical before and after decoding the image.
      element.style.height = `${element.getBoundingClientRect().width / ratio}px`;
    }
  };

  // Keep this breakpoint in sync with the mobile layout below. Phones use document scrolling;
  // a desktop reading preference must never put them back into the paginated container.
  const mobile = matchMedia('(max-width: 860px)');
  const paged = () => reader.dataset.mode !== 'scroll';
  // One window of the flow is its own width (two columns) plus one column gap.
  const step = () => flow.clientWidth + parseFloat(getComputedStyle(flow).columnGap);
  // The left edge of the window (the pages box, inside its padding).
  const edge = () => pages.getBoundingClientRect().left + parseFloat(getComputedStyle(pages).paddingLeft);
  const loadPageImages = () => {
    if (!paged() || !pendingImages.size) return;
    // Native lazy loading can miss images in off-screen CSS columns moved by a transform.
    // Use flow-relative positions so even a rapid click mid-transition loads the destination
    // spread and the next one. Keep distant images lazy, especially in photo-heavy posts.
    const origin = flow.getBoundingClientRect().left;
    const from = current * step();
    const until = from + 2 * step();
    for (const img of pendingImages) {
      if ([...img.getClientRects()].some((box) => box.right - origin > from && box.left - origin < until)) {
        img.loading = 'eager';
        pendingImages.delete(img);
      }
    }
  };
  const show = (n: number) => {
    current = Math.max(0, Math.min(n, count - 1));
    flow.style.setProperty('--p', String(current));
    where.textContent = paginationReady ? `${current + 1} / ${count}` : '排版中…';
    prev.disabled = current === 0;
    next.disabled = current >= count - 1;
    loadPageImages();
  };
  // Where a block sits along the flow, in windows. (Measured with the flow slid back to the start
  // and its transition off, since a rect taken mid-slide would be partway along.)
  const windowOf = (el: Element) => Math.floor((el.getBoundingClientRect().left - edge() + 1) / step());
  // Measure the flow afresh (on load, resize and mode change) and open at the given block.
  const layout = (keep?: Element | null) => {
    if (!paged()) return;
    flow.style.transition = 'none';
    flow.style.setProperty('--p', '0');
    sizePageMedia();
    count = Math.max(1, Math.round((flow.scrollWidth + step() - flow.clientWidth) / step()));
    show(keep ? windowOf(keep) : current);
    void flow.offsetWidth;
    flow.style.transition = '';
  };
  // The first block in view: at the window's left edge when paged, below the panel's top when scrolling.
  const onScreen = () => {
    // A slide may be under way: snap it to its end before measuring.
    if (paged()) { flow.style.transition = 'none'; void flow.offsetWidth; }
    const r = pages.getBoundingClientRect();
    const left = edge();
    const found = marks.find((e) => {
      const b = e.getBoundingClientRect();
      return paged() ? b.left >= left - 1 : b.bottom > (mobile.matches ? 0 : r.top) + 1;
    }) ?? null;
    flow.style.transition = '';
    return found;
  };
  const goTo = (el: HTMLElement | null, mark = false) => {
    if (!el) return;
    if (paged()) layout(el);
    else if (mobile.matches) {
      window.scrollTo({ top: window.scrollY + el.getBoundingClientRect().top - 24, behavior: 'instant' });
    } else {
      // 40px of headroom, so the landing wash isn't cut at the top.
      pages.scrollTop = el.offsetTop - 40;
      // Once more after paint: images above it may still be settling into their sizes.
      requestAnimationFrame(() => { pages.scrollTop = el.offsetTop - 40; });
    }
    if (mark) {
      // Show where we landed: the entry lights up for a moment.
      el.classList.remove('landed');
      void el.offsetWidth;
      el.classList.add('landed');
      el.addEventListener('animationend', () => el.classList.remove('landed'), { once: true });
    }
  };
  const setMode = (mode: 'page' | 'scroll', keep: HTMLElement | null) => {
    reader.dataset.mode = mobile.matches ? 'scroll' : mode;
    if (!paged()) sizePageMedia();
    const toScroll = paged();
    modeButton.title = modeButton.ariaLabel = toScroll ? 'Switch to scrolling' : 'Switch to pages';
    pages.scrollTop = 0;
    if (paged()) layout(keep);
    else goTo(keep);
  };

  let mode: 'page' | 'scroll' = 'page';
  try { if (localStorage.getItem('reader-mode') === 'scroll') mode = 'scroll'; } catch {}
  reader.classList.add('ready');
  // Back from a post (the button by its running head): open the index at that post's entry, and mark it.
  let returnedTo: HTMLElement | undefined;
  try {
    const from = sessionStorage.getItem('reader-back');
    sessionStorage.removeItem('reader-back');
    if (from) returnedTo = entries.find((e) => e.querySelector<HTMLAnchorElement>('h2 a')?.pathname === from);
  } catch {}
  const start = Number(reader.dataset.start) || 0;
  setMode(mode, returnedTo ?? (start > 0 ? marks[start] : null) ?? null);
  if (returnedTo) goTo(returnedTo, true);
  // Fonts can remain pending on a slow connection. Briefly allow the initial font swap,
  // then expose the already measured fallback layout instead of hiding page numbers forever.
  const fontWait = setTimeout(() => { paginationReady = true; show(current); }, 1500);
  document.fonts.ready.then(() => {
    clearTimeout(fontWait);
    paginationReady = true;
    layout(onScreen());
  });
  addEventListener('resize', () => {
    const keep = onScreen();
    const expected = mobile.matches ? 'scroll' : mode;
    if (reader.dataset.mode !== expected) setMode(mode, keep);
    else layout(keep);
  });
  // Only unmeasured external images need another layout. Known media already has its final box.
  const measured = new Set(sizedMedia.filter(item => item.width > 0 && item.height > 0).map(item => item.element));
  for (const img of flow.querySelectorAll('img')) if (!measured.has(img)) img.addEventListener('load', () => layout(onScreen()), { once: true });

  // A video plays only while it's in view: paging (or scrolling) it out of the window pauses it,
  // and starting one pauses any other, so two never play over each other.
  const media = [...flow.querySelectorAll<HTMLMediaElement>('video, audio')];
  const inView = new IntersectionObserver((seen) => {
    for (const s of seen) if (!s.isIntersecting) (s.target as HTMLMediaElement).pause();
  });
  for (const m of media) {
    inView.observe(m);
    m.addEventListener('play', () => { for (const o of media) if (o !== m) o.pause(); });
  }

  // The quality menu on each video that has smaller copies (data-qualities, largest first; the
  // page's src is the 1080p one). The pick is remembered and applies to every video: the copy of
  // that height, or the nearest smaller one. Switching keeps the place and whether it was playing.
  interface Quality { label: string; height: number; src: string }
  let wanted = 1080;
  try { wanted = Number(localStorage.getItem('video-quality')) || 1080; } catch {}
  const pickFor = (qs: Quality[]) => qs.find((q) => q.height <= wanted) ?? qs[qs.length - 1];
  const pickers: (() => void)[] = [];
  for (const v of flow.querySelectorAll<HTMLVideoElement>('video[data-qualities]')) {
    const frame = v.parentElement!;
    const qs: Quality[] = JSON.parse(v.dataset.qualities!);
    const box = document.createElement('div');
    box.className = 'vq-pick';
    box.innerHTML = `<button type="button" aria-haspopup="menu" aria-label="Quality"></button><ul role="menu">${qs.map((q, i) =>
      `<li><button type="button" role="menuitemradio" data-i="${i}">${q.label}</button></li>`).join('')}</ul>`;
    frame.append(box);
    const toggle = box.querySelector<HTMLButtonElement>(':scope > button')!;
    const items = [...box.querySelectorAll<HTMLButtonElement>('li > button')];
    const use = (q: Quality) => {
      toggle.textContent = q.label;
      items.forEach((b, i) => b.setAttribute('aria-checked', String(qs[i] === q)));
      if (v.getAttribute('src') === q.src) return;
      const at = v.currentTime, playing = !v.paused;
      v.src = q.src;
      if (at > 0 || playing) {
        v.addEventListener('loadedmetadata', () => { v.currentTime = at; if (playing) v.play(); }, { once: true });
        v.load();
      }
    };
    use(pickFor(qs));
    pickers.push(() => use(pickFor(qs)));
    toggle.addEventListener('click', (e) => { e.stopPropagation(); box.classList.toggle('open'); });
    items.forEach((b, i) => b.addEventListener('click', (e) => {
      e.stopPropagation();
      box.classList.remove('open');
      wanted = qs[i].height;
      try { localStorage.setItem('video-quality', String(wanted)); } catch {}
      use(qs[i]);
      // The others follow, without interrupting them (they're paused: only one plays at a time).
      pickers.forEach((p) => p());
    }));
    v.addEventListener('play', () => frame.classList.add('playing'));
    v.addEventListener('pause', () => frame.classList.remove('playing'));
  }
  addEventListener('click', () => { for (const b of flow.querySelectorAll('.vq-pick.open')) b.classList.remove('open'); });

  prev.addEventListener('click', () => show(current - 1));
  next.addEventListener('click', () => show(current + 1));
  addEventListener('keydown', (e) => {
    if (!paged() || document.querySelector('dialog[open]') || e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
  document.querySelector<HTMLAnchorElement>('.reader-head .back')?.addEventListener('click', (e) => {
    try { sessionStorage.setItem('reader-back', (e.currentTarget as HTMLAnchorElement).dataset.post!); } catch {}
  });
  modeButton.addEventListener('click', () => {
    if (mobile.matches) return;
    const keep = onScreen();
    mode = paged() ? 'scroll' : 'page';
    try { localStorage.setItem('reader-mode', mode); } catch {}
    setMode(mode, keep);
  });

  // The catalogue: the index's posts, or a post's section headings. Each item has its target in
  // the flow (an entry, or a heading by id); the one in view is marked, and picking one opens the
  // reader there.
  const items = [...toc.querySelectorAll<HTMLButtonElement>('li > button')];
  const targetOf = (b: HTMLButtonElement) => b.dataset.id ? document.getElementById(b.dataset.id) : entries[Number(b.dataset.i)];
  // The item in view: the entry on screen, or the last heading at or before the reading position.
  const itemInView = () => {
    if (entries.length) { const here = onScreen(); return here ? entries.indexOf(here) : -1; }
    const here = onScreen();
    if (!here) return -1;
    const pos = here.compareDocumentPosition.bind(here);
    let at = -1;
    items.forEach((b, i) => { const t = targetOf(b); if (t && (t === here || pos(t) & Node.DOCUMENT_POSITION_PRECEDING)) at = i; });
    return at;
  };
  document.querySelector('.rail .toc-open')?.addEventListener('click', () => {
    const at = itemInView();
    items.forEach((b, i) => { if (i === at) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); });
    toc.showModal();
    items[Math.max(0, at)]?.scrollIntoView({ block: 'center' });
  });
  // Every drawer (the catalogue, and a post's comments) closes by its × or a click on the backdrop.
  for (const d of document.querySelectorAll<HTMLDialogElement>('dialog.drawer')) {
    d.querySelector('.drawer-close')?.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  }
  items.forEach((b) => b.addEventListener('click', () => { toc.close(); goTo(targetOf(b), !!entries.length); }));
</script>

<style>
  /* The panel and its rail fill the window below the header. */
  .reading { display: flex; align-items: stretch; gap: 20px; height: calc(100dvh - 104px - 28px); min-height: 520px; }
  .reader {
    --gap: 80px;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 32px 64px 22px;
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    border-radius: 16px;
  }
  .reader-head { flex: none; position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28px; }
  .running { font: 700 13px/1 "Lato", sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: var(--faint); }
  /* The way back to the index, a small round button before the running head. */
  .running .back { display: inline-grid; place-items: center; width: 28px; height: 28px; margin: -8px 10px -8px -2px; vertical-align: middle; border: 1px solid var(--line); border-radius: 50%; color: var(--muted); }
  .running .back:hover { color: var(--accent); border-color: var(--accent); }
  .running .back svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .motto-sm { font: 400 12px/1 var(--serif); letter-spacing: 2px; color: var(--faint); }

  /* The flow is set in columns the height of the window, running off to the right; a window shows
     two of them, and --p slides the flow one window (two columns and a gap) at a time. The box
     clips them a little wider than the text (padding pushed out by negative margins), so the
     index's landing wash isn't cut at the edges. */
  .pages { flex: 1 1 auto; min-height: 0; overflow: hidden; margin: -40px -28px -12px; padding: 40px 28px 12px; position: relative; }
  /* The cover: the whole first column, its text centred a little above the middle. */
  .cover { height: 100%; break-after: column; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 0 14%; }
  .flow { height: 100%; columns: 2; column-gap: var(--gap); column-fill: auto;
    transform: translateX(calc(var(--p, 0) * (-100% - var(--gap)))); transition: transform .4s cubic-bezier(.2, .7, .2, 1); }
  @media (prefers-reduced-motion: reduce) { .flow { transition: none; } }

  .reader-foot { flex: none; display: flex; justify-content: space-between; align-items: center; margin-top: 16px; font-size: 14px; letter-spacing: 1px; color: var(--muted); }
  .reader-foot button { font: inherit; color: inherit; padding: 6px 14px; border: 1px solid var(--line); border-radius: 20px; background: transparent; cursor: pointer; }
  .reader-foot button:hover:not(:disabled) { color: var(--ink); border-color: var(--muted); }
  .reader-foot button:disabled { visibility: hidden; }
  .where { font-variant-numeric: tabular-nums; color: var(--faint); }
  .reader:not(.ready) .where, .reader:not(.ready) .reader-foot button { visibility: hidden; }

  /* 滚动: one column of reading width, scrolling inside the panel; no page buttons. */
  .reader[data-mode="scroll"] .pages { overflow-y: auto; margin: 0 -28px; padding: 0 28px; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
  .reader[data-mode="scroll"] .flow { height: auto; columns: auto; width: min(100%, 760px); margin: 0 auto; transform: none; transition: none; }
  .reader[data-mode="scroll"] .reader-foot { display: none; }
  .reader[data-mode="scroll"] .cover { height: auto; min-height: 60vh; padding: 8% 0 12%; }

  /* The rail: the catalogue and the 翻页 / 滚动 switch beside the panel, round buttons. */
  .rail { flex: none; align-self: center; display: flex; flex-direction: column; gap: 16px; }
  .rail :global(button) { width: 44px; height: 44px; padding: 0; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: var(--panel); color: var(--muted); cursor: pointer; }
  .rail :global(button:hover) { color: var(--accent); border-color: var(--accent); }
  .rail :global(svg) { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .rail .ico-page, .reader[data-mode="scroll"] ~ .rail .ico-scroll { display: none; }
  .reader[data-mode="scroll"] ~ .rail .ico-page { display: block; }

  /* The catalogue, in a drawer (see .drawer in global.css). */
  .toc ol { flex: 1 1 auto; min-height: 0; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line) transparent; list-style: none; margin: 0; padding: 10px 0 24px; }
  .toc li > * { display: block; width: 100%; padding: 11px 28px; border: 0; background: transparent; color: var(--body); font: inherit; text-align: left; cursor: pointer; }
  .toc li > :hover { color: var(--accent); background: var(--paper-2); }
  .toc li > [aria-current] { color: var(--ink); background: var(--paper-2); box-shadow: 3px 0 0 var(--accent) inset; }
