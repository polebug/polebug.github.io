---
import { beijingParts, getPosts } from '../lib/posts';

const published = (await getPosts()).filter((post) => !post.draft);
const currentYear = beijingParts(new Date()).year;
const year = Astro.params.year ?? currentYear;
const years = [...new Set([currentYear, year, ...published.map((post) => post.ymd.year)])].sort().reverse();
const posts = published.filter((post) => post.ymd.year === year);
const byDay = new Map<string, typeof posts>();
for (const post of posts) {
  const date = `${post.ymd.year}-${post.ymd.month}-${post.ymd.day}`;
  byDay.set(date, [...(byDay.get(date) ?? []), post]);
}
// UTC is used only for calendar arithmetic; post dates already use Beijing time.
const first = Date.UTC(Number(year), 0, 1);
const last = Date.UTC(Number(year) + 1, 0, 1);
const offset = new Date(first).getUTCDay();
const dayCount = (last - first) / 86400000;
const columns = Math.ceil((offset + dayCount) / 7);
const days = Array.from({ length: columns * 7 }, (_, index) => {
  const day = index - offset;
  if (day < 0 || day >= dayCount) return null;
  const date = new Date(first + day * 86400000).toISOString().slice(0, 10);
  const entries = byDay.get(date) ?? [];
  return { date, entries, level: Math.min(entries.length, 4) };
});
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthColumn = (month: number) => Math.floor((offset + (Date.UTC(Number(year), month, 1) - first) / 86400000) / 7) + 1;
const onFullArchive = !Astro.params.month;
const archiveUrl = onFullArchive ? '' : `/archives/${year}/`;
---

<section class="activity" aria-label="Article publishing calendar">
  <header class="activity-header">
    <div>
      <h2>Writing activity</h2>
      <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} · {byDay.size} {byDay.size === 1 ? 'day' : 'days'} in {year}</p>
    </div>
    <label class="activity-year">
      <span>Year</span>
      <select aria-label="Activity year" data-activity-year>
        {years.map((value) => (
          <option value={value === currentYear ? '/archives/' : `/archives/${value}/`} selected={value === year}>{value}</option>
        ))}
      </select>
    </label>
  </header>
  <div class="activity-scroll" tabindex="0" role="region" aria-label={`${year} publishing calendar; scroll horizontally on small screens`}>
    <div class="activity-chart" style={`--weeks: ${columns}`}>
      <div class="activity-months" aria-hidden="true">
        {months.map((month, index) => <span style={`grid-column: ${monthColumn(index)} / span 3`}>{month}</span>)}
      </div>
      <div class="activity-weekdays" aria-hidden="true"><span>Mon</span><span>Wed</span><span>Fri</span></div>
      <div class="activity-days">
        {days.map((day) => day ? (
          day.entries.length ? (
            <a
              class="activity-day"
              data-level={day.level}
              href={`${archiveUrl}#archive-date-${day.date}`}
              aria-label={`${day.date}: ${day.entries.length} ${day.entries.length === 1 ? 'post' : 'posts'}. ${day.entries.map((post) => post.data.title).join('; ')}`}
              title={`${day.date} · ${day.entries.length} ${day.entries.length === 1 ? 'post' : 'posts'}\n${day.entries.map((post) => post.data.title).join('\n')}`}
            />
          ) : <span class="activity-day" data-level="0" title={`${day.date} · No posts`} />
        ) : <span aria-hidden="true" />)}
      </div>
    </div>
  </div>
  <footer class="activity-footer">
    <span>Published posts · Beijing time</span>
    <div class="activity-legend" aria-label="Color intensity: fewer to more posts per day">
      <span>Less</span>
      {[0, 1, 2, 3, 4].map((level) => <i class="activity-day" data-level={level} aria-hidden="true" />)}
      <span>More</span>
    </div>
  </footer>
</section>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-activity-year]').forEach((select) => {
    select.addEventListener('change', () => { window.location.href = select.value; });
  });
</script>

<style>
  .activity { margin: -20px 0 48px; padding: 24px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font-family: "Lato", sans-serif; }
  .activity-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  h2 { margin: 0; font: 400 16px/1.5 var(--serif); }
  .activity-header p { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
  .activity-year { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); }
  select { background: var(--paper-2); color: var(--ink); border: 1px solid var(--line); border-radius: 5px; padding: 7px 9px; font: inherit; cursor: pointer; }
  select:focus-visible, .activity-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .activity-scroll { overflow-x: auto; padding: 4px; margin: -4px; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
  .activity-chart { display: grid; grid-template-columns: 30px 1fr; grid-template-rows: 20px auto; gap: 6px; min-width: 650px; }
  .activity-months { grid-column: 2; display: grid; grid-template-columns: repeat(var(--weeks), minmax(0, 1fr)); gap: 3px; font-size: 10px; color: var(--muted); }
  .activity-weekdays { grid-row: 2; display: grid; grid-template-rows: repeat(7, 1fr); gap: 3px; color: var(--muted); font-size: 9px; line-height: 1; }
  .activity-weekdays span { align-self: center; }
  .activity-weekdays span:nth-child(1) { grid-row: 2; }
  .activity-weekdays span:nth-child(2) { grid-row: 4; }
  .activity-weekdays span:nth-child(3) { grid-row: 6; }
  .activity-days { display: grid; grid-auto-flow: column; grid-template-columns: repeat(var(--weeks), minmax(0, 1fr)); grid-template-rows: repeat(7, 1fr); gap: 3px; }
  .activity-day { display: block; aspect-ratio: 1; border-radius: 2px; background: var(--paper-2); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--line) 45%, transparent); }
  .activity-day[data-level="1"] { background: color-mix(in srgb, var(--accent) 55%, var(--paper-2)); }
  .activity-day[data-level="2"] { background: color-mix(in srgb, var(--accent) 75%, var(--paper-2)); }
  .activity-day[data-level="3"] { background: var(--accent); }
  .activity-day[data-level="4"] { background: color-mix(in srgb, var(--accent) 70%, var(--ink)); }
  a.activity-day:hover, a.activity-day:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
  .activity-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 16px; font-size: 10px; color: var(--muted); }
  .activity-legend { display: flex; align-items: center; gap: 4px; }
  .activity-legend .activity-day { width: 10px; }
  .activity-legend span:first-child { margin-right: 4px; }
  .activity-legend span:last-child { margin-left: 4px; }
</style>
