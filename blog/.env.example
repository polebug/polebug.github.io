# Copy to .env (never committed). The same values go into the GitHub repository's Actions secrets.

# Gitalk (GitHub OAuth app). Gitalk runs in the browser, so this ends up in the page anyway;
# keeping it out of git just stops it being scraped from the source.
PUBLIC_GITALK_CLIENT_SECRET=

# Where uploaded media is served from (default https://img.polebug.com)
# MEDIA_BASE_URL=https://img.polebug.com
