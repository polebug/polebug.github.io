# Copy to .env (never committed). Needed only by `npm run upload`.
# Cloudflare dashboard → R2 → Manage API tokens → Create token (Object Read & Write, both buckets).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket bound to img.polebug.com: what the blog shows
R2_BUCKET=polebug-media
# Private bucket: untouched originals, a backup only
R2_ORIGINALS_BUCKET=polebug-originals
